@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
}

<div class="auth-form">
    <div class="text-center mb-4">
        <h2 class="auth-title">Welcome Back</h2>
        <p class="auth-subtitle">Sign in to your account to continue</p>
    </div>

    <section>
        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email">Email Address</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            
            <div class="form-check mb-3">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label" asp-for="Input.RememberMe">
                    Remember me
                </label>
            </div>
            
            <div class="d-grid mb-3">
                <button id="login-submit" type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-sign-in-alt me-2"></i>SIGN IN
                </button>
            </div>
            
            <div class="text-center">
                <a id="forgot-password" asp-page="./ForgotPassword" class="text-primary text-decoration-none">
                    Forgot your password?
                </a>
            </div>
        </form>
    </section>

    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
    {
        <div class="divider my-4">
            <span class="divider-text">Or sign in with</span>
        </div>
        
        <section>
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div class="d-grid gap-2">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        @if (provider.Name.ToLower() == "google")
                        {
                            <button type="submit" class="btn btn-outline-danger btn-lg social-btn" name="provider" value="@provider.Name" title="Sign in with @provider.DisplayName">
                                <i class="fab fa-google me-2"></i>Continue with @provider.DisplayName
                            </button>
                        }
                        else if (provider.Name.ToLower() == "facebook")
                        {
                            <button type="submit" class="btn btn-outline-primary btn-lg social-btn" name="provider" value="@provider.Name" title="Sign in with @provider.DisplayName">
                                <i class="fab fa-facebook-f me-2"></i>Continue with @provider.DisplayName
                            </button>
                        }
                        else if (provider.Name.ToLower() == "microsoft")
                        {
                            <button type="submit" class="btn btn-outline-info btn-lg social-btn" name="provider" value="@provider.Name" title="Sign in with @provider.DisplayName">
                                <i class="fab fa-microsoft me-2"></i>Continue with @provider.DisplayName
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-outline-secondary btn-lg social-btn" name="provider" value="@provider.Name" title="Sign in with @provider.DisplayName">
                                <i class="fas fa-sign-in-alt me-2"></i>Continue with @provider.DisplayName
                            </button>
                        }
                    }
                </div>
            </form>
        </section>
    }
    else
    {
        <div class="divider my-4">
            <span class="divider-text">Use another service to log in</span>
        </div>
        
        <div class="external-auth-info">
            <div class="alert alert-info">
                <h6 class="mb-2">No External Authentication Services</h6>
                <p class="mb-2">There are no external authentication services configured.</p>
                <a href="https://go.microsoft.com/fwlink/?LinkID=532715" class="alert-link" target="_blank">
                    Learn how to configure external authentication
                </a>
            </div>
            
            <!-- Sample Social Login Buttons (for demonstration) -->
            <div class="d-grid gap-2 mt-3">
                <button type="button" class="btn btn-outline-danger btn-lg social-btn" disabled>
                    <i class="fab fa-google me-2"></i>Continue with Google
                </button>
                <button type="button" class="btn btn-outline-primary btn-lg social-btn" disabled>
                    <i class="fab fa-facebook-f me-2"></i>Continue with Facebook
                </button>
                <button type="button" class="btn btn-outline-info btn-lg social-btn" disabled>
                    <i class="fab fa-microsoft me-2"></i>Continue with Microsoft
                </button>
            </div>
            <small class="text-muted text-center d-block mt-2">External authentication is not configured</small>
        </div>
    }
    
    <hr class="my-4">
    
    <div class="text-center">
        <p class="mb-2">Don't have an account?</p>
        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-outline-primary btn-lg">
            <i class="fas fa-user-plus me-2"></i>CREATE ACCOUNT
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
