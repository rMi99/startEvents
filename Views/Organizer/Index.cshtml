@model dynamic
@{
    ViewData["Title"] = "Organizer Dashboard";
    ViewData["ActivePage"] = "Dashboard";
    Layout = "_OrganizerLayout";
}

<div class="organizer-dashboard">
    <!-- Dashboard Statistics -->
    <div class="row mb-4">
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-calendar fa-2x"></i>
                        </div>
                        <div class="ms-3">
                            <h3 class="mb-0">@Model.TotalEvents</h3>
                            <small>My Events</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-ticket-alt fa-2x"></i>
                        </div>
                        <div class="ms-3">
                            <h3 class="mb-0">@Model.TotalTicketsSold</h3>
                            <small>Tickets Sold</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-dollar-sign fa-2x"></i>
                        </div>
                        <div class="ms-3">
                            <h3 class="mb-0">$@Model.TotalRevenue.ToString("N2")</h3>
                            <small>Total Revenue</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-eye fa-2x"></i>
                        </div>
                        <div class="ms-3">
                            <h3 class="mb-0">@Model.PublishedEvents</h3>
                            <small>Published</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <!-- Recent Events -->
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-calendar-alt me-2"></i>My Recent Events
                    </h5>
                    <a asp-controller="Organizer" asp-action="CreateEvent" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus me-2"></i>Create Event
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.MyEvents != null && Model.MyEvents.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Event</th>
                                        <th>Date</th>
                                        <th>Venue</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var eventItem in Model.MyEvents)
                                    {
                                        <tr>
                                            <td>@eventItem.Title</td>
                                            <td>@eventItem.EventDate.ToString("MMM dd, yyyy")</td>
                                            <td>@eventItem.Venue.Name</td>
                                            <td>
                                                @if (eventItem.IsPublished)
                                                {
                                                    <span class="badge bg-success">Published</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">Draft</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Details", "Events", new { id = eventItem.Id })" class="btn btn-sm btn-outline-info">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a href="@Url.Action("Edit", "Events", new { id = eventItem.Id })" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-calendar-plus fa-3x text-muted mb-3"></i>
                            <h6 class="text-muted">No events created yet</h6>
                            <p class="text-muted">Create your first event to get started!</p>
                            <a asp-controller="Organizer" asp-action="CreateEvent" class="btn btn-primary">
                                <i class="fas fa-plus me-2"></i>Create Your First Event
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <!-- Quick Actions -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-bolt me-2"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-controller="Organizer" asp-action="CreateEvent" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Create New Event
                        </a>
                        <a asp-controller="Organizer" asp-action="MyEvents" class="btn btn-outline-secondary">
                            <i class="fas fa-calendar-alt me-2"></i>Manage My Events
                        </a>
                        <a asp-controller="Organizer" asp-action="Analytics" class="btn btn-outline-info">
                            <i class="fas fa-chart-line me-2"></i>View Analytics
                        </a>
                        <a asp-controller="Organizer" asp-action="EventTickets" class="btn btn-outline-success">
                            <i class="fas fa-ticket-alt me-2"></i>Ticket Sales
                        </a>
                    </div>
                </div>
            </div>
            
            <!-- Performance Summary -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-pie me-2"></i>Performance Summary
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <span>Events Published</span>
                            <strong>@Model.PublishedEvents / @Model.TotalEvents</strong>
                        </div>
                        <div class="progress mt-1">
                            <div class="progress-bar bg-success" style="width: @(Model.TotalEvents > 0 ? (Model.PublishedEvents * 100 / Model.TotalEvents) : 0)%"></div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <span>This Month's Revenue</span>
                            <strong>$@Model.TotalRevenue.ToString("N2")</strong>
                        </div>
                    </div>
                    
                    <div class="mb-0">
                        <div class="d-flex justify-content-between">
                            <span>Total Tickets Sold</span>
                            <strong>@Model.TotalTicketsSold</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>