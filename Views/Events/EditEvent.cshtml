@model online_event_booking.Data.Entities.Event

@{
    ViewData["Title"] = "Edit Event";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-soft">
                <div class="card-header bg-gradient-primary text-white">
                    <h3 class="mb-0">Edit Event</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Category" class="form-label"></label>
                            <select asp-for="Category" class="form-select">
                                <option value="Concert" selected="@Model.Category == " Concert"">Concert</option>
                                <option value="Theatre" selected="@Model.Category == " Theatre"">Theatre</option>
                                <option value="Cultural" selected="@Model.Category == " Cultural"">Cultural</option>
                                <option value="Sports" selected="@Model.Category == " Sports"">Sports</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventDate" class="form-label"></label>
                            <input asp-for="EventDate" type="date" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventTime" class="form-label"></label>
                            <input asp-for="EventTime" type="time" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="VenueId" class="form-label">Venue</label>
                            <select asp-for="VenueId" class="form-select" asp-items="ViewBag.VenueId"></select>
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-2"></i>Update
                            </button>

                            <button type="button" class="btn btn-danger" onclick="confirmDelete(@Model.Id)">
                                <i class="fas fa-trash me-2"></i>Delete
                            </button>

                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Back
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function confirmDelete(eventId) {
            if (confirm("Are you sure you want to delete this event?")) {
                // Redirect to DeleteConfirmed action
                window.location.href = '/Events/DeleteConfirmed/' + eventId;
            }
        }
    </script>
}
