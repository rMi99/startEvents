@model online_event_booking.Data.Entities.Event

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Events" asp-action="Index">Events</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Event Image/Banner -->
        <div class="col-lg-8">
            <div class="event-banner mb-4" style="height: 400px; background: var(--gradient-primary); border-radius: var(--border-radius-lg); position: relative; overflow: hidden;">
                <div class="d-flex align-items-center justify-content-center h-100">
                    @{
                        var iconClass = Model.Category?.ToLower() switch
                        {
                            "concert" => "fas fa-music",
                            "theatre" => "fas fa-theater-masks",
                            "cultural" => "fas fa-palette",
                            "sports" => "fas fa-futbol",
                            _ => "fas fa-calendar-alt"
                        };
                    }
                    <i class="@iconClass text-white" style="font-size: 8rem; opacity: 0.7;"></i>
                </div>
                <div class="position-absolute top-0 start-0 p-4">
                    <span class="badge bg-dark bg-opacity-75 fs-6">@Model.Category</span>
                </div>
                @if (Model.EventDate <= DateTime.Now.AddDays(7))
                {
                    <div class="position-absolute top-0 end-0 p-4">
                        <span class="badge bg-danger fs-6">Hot Event</span>
                    </div>
                }
            </div>

            <!-- Event Details -->
            <div class="card shadow-soft mb-4">
                <div class="card-body">
                    <h1 class="card-title display-4 mb-3">@Model.Title</h1>
                    
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="feature-icon-sm me-3" style="background: var(--primary-color);">
                                    <i class="fas fa-calendar-alt text-white"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0">Date & Time</h6>
                                    <small class="text-muted">@Model.EventDate.ToString("dddd, MMMM dd, yyyy 'at' hh:mm tt")</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="feature-icon-sm me-3" style="background: var(--success-color);">
                                    <i class="fas fa-map-marker-alt text-white"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0">Venue</h6>
                                    <small class="text-muted">@Model.Venue?.Name, @Model.Venue?.Location</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h5>About This Event</h5>
                        <p class="text-muted">@Html.Raw(Model.Description)</p>
                    </div>

                    @if (Model.Venue != null)
                    {
                        <div class="mb-4">
                            <h5>Venue Information</h5>
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6>@Model.Venue.Name</h6>
                                    <p class="mb-2">
                                        <i class="fas fa-map-marker-alt me-2"></i>@Model.Venue.Location
                                    </p>
                                    <p class="mb-0">
                                        <i class="fas fa-users me-2"></i>Capacity: @Model.Venue.Capacity persons
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Booking Sidebar -->
        <div class="col-lg-4">
            <div class="card shadow-soft sticky-top" style="top: 100px;">
                <div class="card-header bg-gradient-primary text-white text-center">
                    <h5 class="mb-0">
                        <i class="fas fa-ticket-alt me-2"></i>Book Your Tickets
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.Prices?.Any() == true)
                    {
                        <div class="mb-4">
                            <h6>Ticket Prices</h6>
                            @foreach (var price in Model.Prices.OrderBy(p => p.Price))
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2 p-2 border rounded">
                                    <div>
                                        <strong>@price.Category</strong>
                                        <br>
                                        <small class="text-muted">Stock: @price.Stock tickets available</small>
                                    </div>
                                    <div class="text-end">
                                        <strong class="text-success">$@price.Price.ToString("F2")</strong>
                                    </div>
                                </div>
                            }
                        </div>
                        
                        <div class="mb-3">
                            <label for="ticketCategory" class="form-label">Select Category</label>
                            <select class="form-select" id="ticketCategory">
                                @foreach (var price in Model.Prices.OrderBy(p => p.Price))
                                {
                                    <option value="@price.Id" data-price="@price.Price">@price.Category - $@price.Price.ToString("F2")</option>
                                }
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label for="ticketQuantity" class="form-label">Quantity</label>
                            <div class="input-group">
                                <button class="btn btn-outline-secondary" type="button" onclick="changeQuantity(-1)">
                                    <i class="fas fa-minus"></i>
                                </button>
                                <input type="number" class="form-control text-center" id="ticketQuantity" value="1" min="1" max="10">
                                <button class="btn btn-outline-secondary" type="button" onclick="changeQuantity(1)">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                        </div>
                        
                        <div class="mb-3 p-3 bg-light rounded">
                            <div class="d-flex justify-content-between">
                                <span>Subtotal:</span>
                                <span id="subtotal">$@Model.Prices.Min(p => p.Price).ToString("F2")</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Service Fee:</span>
                                <span id="serviceFee">$5.00</span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between">
                                <strong>Total:</strong>
                                <strong id="total">$@(Model.Prices.Min(p => p.Price) + 5).ToString("F2")</strong>
                            </div>
                        </div>
                        
                        <div class="d-grid mb-3">
                            <button type="button" class="btn btn-primary btn-lg" onclick="proceedToCheckout()">
                                <i class="fas fa-shopping-cart me-2"></i>Add to Cart
                            </button>
                        </div>
                        
                        <div class="d-grid">
                            <button type="button" class="btn btn-success btn-lg" onclick="buyNow()">
                                <i class="fas fa-bolt me-2"></i>Buy Now
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-clock text-muted mb-3" style="font-size: 3rem;"></i>
                            <h6>Tickets Coming Soon</h6>
                            <p class="text-muted">Ticket pricing will be announced soon.</p>
                            <button type="button" class="btn btn-outline-primary" onclick="notifyMe()">
                                <i class="fas fa-bell me-2"></i>Notify Me
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Event Features -->
            <div class="card shadow-soft mt-4">
                <div class="card-body">
                    <h6 class="card-title">Event Features</h6>
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-qrcode text-primary me-2"></i>
                        <small>Digital QR Tickets</small>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-mobile-alt text-primary me-2"></i>
                        <small>Mobile Entry</small>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-shield-alt text-primary me-2"></i>
                        <small>Secure Payment</small>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="fas fa-undo text-primary me-2"></i>
                        <small>Refund Protection</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPrice = @(Model.Prices?.Any() == true ? Model.Prices.Min(p => p.Price) : 0);
        
        function changeQuantity(delta) {
            const quantityInput = document.getElementById('ticketQuantity');
            let newQuantity = parseInt(quantityInput.value) + delta;
            
            if (newQuantity < 1) newQuantity = 1;
            if (newQuantity > 10) newQuantity = 10;
            
            quantityInput.value = newQuantity;
            updateTotal();
        }
        
        function updateTotal() {
            const quantity = parseInt(document.getElementById('ticketQuantity').value);
            const select = document.getElementById('ticketCategory');
            const selectedOption = select.options[select.selectedIndex];
            currentPrice = parseFloat(selectedOption.dataset.price);
            
            const subtotal = currentPrice * quantity;
            const serviceFee = 5.00;
            const total = subtotal + serviceFee;
            
            document.getElementById('subtotal').textContent = '$' + subtotal.toFixed(2);
            document.getElementById('total').textContent = '$' + total.toFixed(2);
        }
        
        function proceedToCheckout() {
            const quantity = document.getElementById('ticketQuantity').value;
            const category = document.getElementById('ticketCategory').value;
            
            // TODO: Implement add to cart functionality
            alert(`Added ${quantity} ticket(s) to cart!`);
        }
        
        function buyNow() {
            const quantity = document.getElementById('ticketQuantity').value;
            const category = document.getElementById('ticketCategory').value;
            
            // TODO: Implement direct purchase functionality
            alert(`Proceeding to checkout for ${quantity} ticket(s)!`);
        }
        
        function notifyMe() {
            // TODO: Implement notification signup
            alert('You will be notified when tickets become available!');
        }
        
        // Event listeners
        document.getElementById('ticketCategory')?.addEventListener('change', updateTotal);
        document.getElementById('ticketQuantity')?.addEventListener('input', updateTotal);
        
        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });
    </script>
}
