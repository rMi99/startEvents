@model IEnumerable<online_event_booking.Data.Entities.Ticket>
@{
    ViewData["Title"] = "My Tickets";
    ViewData["ActivePage"] = "MyTickets";
    Layout = "_CustomerLayout";
}

<div class="customer-tickets">
    @if (Model.Any())
    {
        <div class="row">
            @foreach (var ticket in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card ticket-card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">Ticket #@ticket.TicketNumber</h6>
                            @if (ticket.IsPaid)
                            {
                                <span class="badge bg-success">Paid</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@ticket.Event.Title</h5>
                            <p class="card-text">
                                <i class="fas fa-calendar me-2"></i>@ticket.Event.EventDate.ToString("MMM dd, yyyy")
                                <br>
                                <i class="fas fa-clock me-2"></i>@ticket.Event.EventTime.ToString(@"hh\:mm")
                                <br>
                                <i class="fas fa-map-marker-alt me-2"></i>@ticket.Event.Venue.Name
                            </p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted">Qty: @ticket.Quantity</span>
                                <span class="fw-bold">$@ticket.TotalAmount.ToString("N2")</span>
                            </div>
                            <div class="mt-3">
                                <a href="@Url.Action("Details", "Events", new { id = ticket.EventId })" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-eye me-1"></i>View Event
                                </a>
                                @if (ticket.QrCodePath != null)
                                {
                                    <button class="btn btn-outline-secondary btn-sm">
                                        <i class="fas fa-qrcode me-1"></i>QR Code
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="card-footer text-muted">
                            <small>Purchased: @ticket.PurchaseDate.ToString("MMM dd, yyyy")</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-ticket-alt fa-4x text-muted mb-3"></i>
            <h4>No Tickets Yet</h4>
            <p class="text-muted">You haven't purchased any tickets yet. Browse events to get started!</p>
            <a asp-controller="Events" asp-action="Index" class="btn btn-primary">
                <i class="fas fa-calendar me-2"></i>Browse Events
            </a>
        </div>
    }
</div>

<style>
    .ticket-card {
        transition: transform 0.2s ease-in-out;
    }
    
    .ticket-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
</style>
