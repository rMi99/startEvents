@model dynamic
@{
    ViewData["Title"] = "Customer Dashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="dashboard-content">
    <!-- Page Header -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="page-title">Welcome Back!</h2>
                <p class="page-subtitle">Discover amazing events and manage your bookings</p>
            </div>
            <div>
                <a href="@Url.Action("Index", "Events")" class="btn btn-primary">
                    <i class="fas fa-search"></i> Browse Events
                </a>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-content">
                    <div class="stats-number">@Model.TotalTickets</div>
                    <div class="stats-label">My Tickets</div>
                    <div class="stats-change positive">
                        <i class="fas fa-arrow-up"></i> 5%
                    </div>
                </div>
                <div class="stats-icon">
                    <i class="fas fa-ticket-alt"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-content">
                    <div class="stats-number">@Model.UpcomingEvents</div>
                    <div class="stats-label">Upcoming Events</div>
                    <div class="stats-change positive">
                        <i class="fas fa-arrow-up"></i> 8%
                    </div>
                </div>
                <div class="stats-icon">
                    <i class="fas fa-calendar-check"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-content">
                    <div class="stats-number">$@Model.TotalSpent.ToString("N2")</div>
                    <div class="stats-label">Total Spent</div>
                    <div class="stats-change positive">
                        <i class="fas fa-arrow-up"></i> 12%
                    </div>
                </div>
                <div class="stats-icon">
                    <i class="fas fa-dollar-sign"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-content">
                    <div class="stats-number">@Model.LoyaltyPoints</div>
                    <div class="stats-label">Loyalty Points</div>
                    <div class="stats-change positive">
                        <i class="fas fa-arrow-up"></i> 15%
                    </div>
                </div>
                <div class="stats-icon">
                    <i class="fas fa-star"></i>
                </div>
            </div>
        </div>
    </div>
    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="dashboard-card">
                <div class="card-header">
                    <h5 class="card-title">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <a href="@Url.Action("Index", "Events")" class="btn btn-primary w-100">
                                <i class="fas fa-search me-2"></i>Browse Events
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a href="#" class="btn btn-outline-primary w-100">
                                <i class="fas fa-ticket-alt me-2"></i>My Tickets
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a href="#" class="btn btn-outline-primary w-100">
                                <i class="fas fa-heart me-2"></i>Favorites
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a href="#" class="btn btn-outline-primary w-100">
                                <i class="fas fa-user-cog me-2"></i>Settings
                            </a>
                        </div>
                    </div>
                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
            </div>
        </div>
    </div>

    <!-- My Tickets Section -->
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="dashboard-card">
                <div class="card-header">
                    <h5 class="card-title">My Recent Tickets</h5>
                    <div class="card-actions">
                        <a href="#" class="btn btn-outline-secondary btn-sm">View All</a>
                    </div>
                </div>
                <div class="card-body">

    <!-- Recent Tickets and Upcoming Events -->
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-history me-2"></i>Recent Tickets</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentTickets.Count > 0)
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var ticket in Model.RecentTickets)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@ticket.Event.Title</h6>
                                        <small>@ticket.PurchaseDate.ToString("MMM dd")</small>
                                    </div>
                                    <p class="mb-1">
                                        <i class="fas fa-map-marker-alt me-1"></i>@ticket.Event.Venue?.Name
                                    </p>
                                    <p class="mb-1">
                                        <i class="fas fa-ticket-alt me-1"></i>Quantity: @ticket.Quantity | 
                                        <i class="fas fa-dollar-sign me-1"></i>$@ticket.TotalAmount.ToString("N2")
                                    </p>
                                    <small class="text-muted">Ticket Code: @ticket.TicketCode</small>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-ticket-alt fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No tickets purchased yet.</p>
                            <a href="@Url.Action("BrowseEvents", "Customer")" class="btn btn-primary">
                                <i class="fas fa-search me-2"></i>Browse Events
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-clock me-2"></i>My Upcoming Events</h5>
                </div>
                <div class="card-body">
                    @if (Model.UpcomingEventsList.Count > 0)
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var ticket in Model.UpcomingEventsList)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@ticket.Event.Title</h6>
                                        <span class="badge bg-success">Upcoming</span>
                                    </div>
                                    <p class="mb-1">
                                        <i class="fas fa-map-marker-alt me-1"></i>@ticket.Event.Venue?.Name
                                    </p>
                                    <p class="mb-1">
                                        <i class="fas fa-calendar me-1"></i>@ticket.Event.EventDate.ToString("MMM dd, yyyy")
                                    </p>
                                    <small class="text-success">
                                        <i class="fas fa-ticket-alt me-1"></i>@ticket.Quantity ticket(s) - Code: @ticket.TicketCode
                                    </small>
                                    <div class="mt-2">
                                        <a href="@Url.Action("EventDetails", "Customer", new { id = ticket.Event.Id })" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-info-circle me-1"></i>Event Details
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No upcoming events.</p>
                            <a href="@Url.Action("BrowseEvents", "Customer")" class="btn btn-primary">
                                <i class="fas fa-search me-2"></i>Find Events
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.stats-card {
    border: none;
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    transition: transform 0.2s;
}

.stats-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
}

.stats-icon {
    font-size: 2rem;
    opacity: 0.7;
}

.btn-block {
    width: 100%;
    padding: 0.75rem;
}

.bg-gradient-info {
    background: linear-gradient(135deg, #17a2b8, #6f42c1);
}
</style>
