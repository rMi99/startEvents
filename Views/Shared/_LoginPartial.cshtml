@using Microsoft.AspNetCore.Identity
@using online_event_booking.Data.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fas fa-user-circle me-1"></i>@(User.Identity?.Name ?? "User")
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            @if (User.IsInRole("Admin"))
            {
                <li>
                    <a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                        <i class="fas fa-crown me-2"></i>Admin Dashboard
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
            }
            @if (User.IsInRole("Organizer"))
            {
                <li>
                    <a class="dropdown-item" asp-controller="Organizer" asp-action="Index">
                        <i class="fas fa-calendar-check me-2"></i>Organizer Dashboard
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="Organizer" asp-action="MyEvents">
                        <i class="fas fa-list me-2"></i>My Events
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
            }
            @if (User.IsInRole("Customer"))
            {
                <li>
                    <a class="dropdown-item" asp-controller="Customer" asp-action="Index">
                        <i class="fas fa-user me-2"></i>My Dashboard
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="Customer" asp-action="MyTickets">
                        <i class="fas fa-ticket-alt me-2"></i>My Tickets
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="Customer" asp-action="LoyaltyPoints">
                        <i class="fas fa-star me-2"></i>Loyalty Points
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
            }
            <li>
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                    <i class="fas fa-cog me-2"></i>Account Settings
                </a>
            </li>
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="dropdown-item">
                        <i class="fas fa-sign-out-alt me-2"></i>Logout
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">
            <i class="fas fa-sign-in-alt me-1"></i>Login
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary ms-2" asp-area="Identity" asp-page="/Account/Register">
            <i class="fas fa-user-plus me-1"></i>Sign Up
        </a>
    </li>
}
</ul>
