<!doctype html>
<html class="no-js" lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>@ViewData["Title"] - StarEvents</title>
    <meta name="description" content="StarEvents - Your premier destination for amazing events and unforgettable experiences">
    <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">
    
    <!-- Template Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Manrope:wght@200..800&family=Montez&display=swap" rel="stylesheet">
    
    <!-- Template CSS -->
    <link rel="stylesheet" href="~/template/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/template/assets/css/fontawesome.min.css">
    <link rel="stylesheet" href="~/template/assets/css/magnific-popup.min.css">
    <link rel="stylesheet" href="~/template/assets/css/swiper-bundle.min.css">
    <link rel="stylesheet" href="~/template/assets/css/style.css">
    
    <!-- Custom CSS for Event Booking -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Template Header -->
    <header class="th-header header-layout1">
        <div class="header-top">
            <div class="container th-container">
                <div class="row justify-content-center justify-content-xl-between align-items-center">
                    <div class="col-auto d-none d-md-block">
                        <div class="header-links">
                            <ul>
                                <li class="d-none d-xl-inline-block">
                                    <i class="fa-sharp fa-regular fa-location-dot"></i> 
                                    <span>123 Event Street, City Center</span>
                                </li>
                                <li class="d-none d-xl-inline-block">
                                    <i class="fa-regular fa-clock"></i> 
                                    <span>Mon to Sat: 9.00 am - 8.00 pm</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="header-right">
                            <div class="header-links">
                                <ul>
                                    <li class="d-none d-md-inline-block">
                                        <a asp-controller="Home" asp-action="Privacy">FAQ</a>
                                    </li>
                                    <li class="d-none d-md-inline-block">
                                        <a asp-controller="Home" asp-action="Contact">Support</a>
                                    </li>
                                    <li>
                                        <partial name="_LoginPartial" />
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="sticky-wrapper">
            <div class="menu-area">
                <div class="container th-container">
                    <div class="row align-items-center justify-content-between">
                        <div class="col-auto">
                            <div class="header-logo">
                                <a asp-controller="Home" asp-action="Index">
                                    <h3 class="text-primary fw-bold mb-0">
                                        <i class="fas fa-star me-2"></i>StarEvents
                                    </h3>
                                </a>
                            </div>
                        </div>
                        <div class="col-auto me-xl-auto">
                            <nav class="main-menu d-none d-xl-inline-block">
                                <ul>
                                    <li>
                                        <a asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Home" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">Home</a>
                                    </li>
                                    <li>
                                        <a asp-controller="Events" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Events" ? "active" : "")">Events</a>
                                    </li>
                                    <li class="menu-item-has-children">
                                        <a href="#">Dashboard</a>
                                        <ul class="sub-menu">
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <li><a asp-controller="Admin" asp-action="Index">Admin Dashboard</a></li>
                                            }
                                            @if (User.IsInRole("Organizer"))
                                            {
                                                <li><a asp-controller="Organizer" asp-action="Index">Organizer Dashboard</a></li>
                                            }
                                            @if (User.IsInRole("Customer"))
                                            {
                                                <li><a asp-controller="Customer" asp-action="Index">Customer Dashboard</a></li>
                                            }
                                        </ul>
                                    </li>
                                    <li>
                                        <a asp-controller="Home" asp-action="About">About Us</a>
                                    </li>
                                    <li>
                                        <a asp-controller="Home" asp-action="Contact">Contact us</a>
                                    </li>
                                </ul>
                            </nav>
                            <button type="button" class="th-menu-toggle d-block d-xl-none">
                                <i class="far fa-bars"></i>
                            </button>
                        </div>
                        <div class="col-auto d-none d-xl-block">
                            <div class="header-button">
                                <a asp-controller="Events" asp-action="Index" class="th-btn style3 th-icon">Book Event</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Mobile Menu -->
    <div class="th-menu-wrapper">
        <div class="th-menu-area text-center">
            <button class="th-menu-toggle"><i class="fal fa-times"></i></button>
            <div class="mobile-logo">
                <a asp-controller="Home" asp-action="Index">
                    <h4 class="text-primary fw-bold"><i class="fas fa-star me-2"></i>StarEvents</h4>
                </a>
            </div>
            <div class="th-mobile-menu">
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-controller="Events" asp-action="Index">Events</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li><a asp-controller="Admin" asp-action="Index">Admin Dashboard</a></li>
                    }
                    @if (User.IsInRole("Organizer"))
                    {
                        <li><a asp-controller="Organizer" asp-action="Index">Organizer Dashboard</a></li>
                    }
                    @if (User.IsInRole("Customer"))
                    {
                        <li><a asp-controller="Customer" asp-action="Index">Customer Dashboard</a></li>
                    }
                    <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                    <li><a asp-controller="Home" asp-action="Contact">Contact us</a></li>
                </ul>
            </div>
        </div>
    </div>

    <main class="main-content">
        @RenderBody()
    </main>

    <!-- Template Footer -->
    <footer class="footer-wrapper footer-layout1">
        <div class="widget-area">
            <div class="container">
                <div class="newsletter-area">
                    <div class="newsletter-top">
                        <div class="row gy-4 align-items-center">
                            <div class="col-lg-5">
                                <h2 class="newsletter-title text-capitalize mb-0">get updated with latest events</h2>
                            </div>
                            <div class="col-lg-7">
                                <form class="newsletter-form">
                                    <input class="form-control" type="email" placeholder="Enter Email" required="">
                                    <button type="submit" class="th-btn style3">Subscribe Now <i class="fas fa-paper-plane ms-2"></i></button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row justify-content-between">
                    <div class="col-md-6 col-xl-3">
                        <div class="widget footer-widget">
                            <div class="th-widget-about">
                                <div class="about-logo">
                                    <a asp-controller="Home" asp-action="Index">
                                        <h4 class="text-white fw-bold"><i class="fas fa-star me-2"></i>StarEvents</h4>
                                    </a>
                                </div>
                                <p class="about-text">Your premier destination for amazing events and unforgettable experiences. Creating memories that last a lifetime.</p>
                                <div class="th-social">
                                    <a href="https://www.facebook.com/"><i class="fab fa-facebook-f"></i></a>
                                    <a href="https://www.twitter.com/"><i class="fab fa-twitter"></i></a>
                                    <a href="https://www.linkedin.com/"><i class="fab fa-linkedin-in"></i></a>
                                    <a href="https://www.instagram.com/"><i class="fab fa-instagram"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-xl-auto">
                        <div class="widget widget_nav_menu footer-widget">
                            <h3 class="widget_title">Quick Links</h3>
                            <div class="menu-all-pages-container">
                                <ul class="menu">
                                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                                    <li><a asp-controller="Events" asp-action="Index">Events</a></li>
                                    <li><a asp-controller="Home" asp-action="About">About us</a></li>
                                    <li><a asp-controller="Home" asp-action="Privacy">Terms of Service</a></li>
                                    <li><a asp-controller="Events" asp-action="Index">Book Event Now</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-xl-auto">
                        <div class="widget footer-widget">
                            <h3 class="widget_title">Contact Info</h3>
                            <div class="th-widget-contact">
                                <div class="info-box_text">
                                    <div class="icon"><i class="fas fa-phone"></i></div>
                                    <div class="details">
                                        <p><a href="tel:+1234567890" class="info-box_link">+1 234 567 890</a></p>
                                        <p><a href="tel:+0987654321" class="info-box_link">+0 987 654 321</a></p>
                                    </div>
                                </div>
                                <div class="info-box_text">
                                    <div class="icon"><i class="fas fa-envelope"></i></div>
                                    <div class="details">
                                        <p><a href="mailto:info@starevents.com" class="info-box_link">info@starevents.com</a></p>
                                        <p><a href="mailto:support@starevents.com" class="info-box_link">support@starevents.com</a></p>
                                    </div>
                                </div>
                                <div class="info-box_text">
                                    <div class="icon"><i class="fas fa-map-marker-alt"></i></div>
                                    <div class="details">
                                        <p>123 Event Street, City Center, State 12345</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-xl-auto">
                        <div class="widget footer-widget">
                            <h3 class="widget_title">Event Categories</h3>
                            <div class="menu-all-pages-container">
                                <ul class="menu">
                                    <li><a href="#">Conferences</a></li>
                                    <li><a href="#">Workshops</a></li>
                                    <li><a href="#">Concerts</a></li>
                                    <li><a href="#">Sports Events</a></li>
                                    <li><a href="#">Corporate Events</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="copyright-wrap">
            <div class="container">
                <div class="row justify-content-between align-items-center">
                    <div class="col-md-6">
                        <p class="copyright-text">Copyright 2025 <a asp-controller="Home" asp-action="Index">StarEvents</a>. All Rights Reserved.</p>
                    </div>
                    <div class="col-md-6 text-end d-none d-md-block">
                        <div class="footer-card">
                            <span class="title">We Accept</span>
                            <i class="fab fa-cc-visa ms-2"></i>
                            <i class="fab fa-cc-mastercard ms-2"></i>
                            <i class="fab fa-cc-paypal ms-2"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Template Scripts -->
    <script src="~/template/assets/js/vendor/jquery-3.6.0.min.js"></script>
    <script src="~/template/assets/js/swiper-bundle.min.js"></script>
    <script src="~/template/assets/js/bootstrap.min.js"></script>
    <script src="~/template/assets/js/jquery.magnific-popup.min.js"></script>
    <script src="~/template/assets/js/jquery.counterup.min.js"></script>
    <script src="~/template/assets/js/jquery-ui.min.js"></script>
    <script src="~/template/assets/js/gsap.min.js"></script>
    <script src="~/template/assets/js/nice-select.min.js"></script>
    <script src="~/template/assets/js/main.js"></script>
    
    <!-- Custom Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
