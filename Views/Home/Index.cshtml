                                <h5 class="box-title">Instant Booking</h5>
                                <p class="about-item_text">Book your tickets instantly with our fast and secure booking system.</p>
                            </div>
                        </div>
                        <div class="about-item">
                            <div class="about-item_img">
                                <i class="fas fa-qrcode" style="font-size: 2rem; color: #FC3737;"></i>
                            </div>
                            <div class="about-item_centent">
