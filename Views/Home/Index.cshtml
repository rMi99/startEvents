                                <p class="about-item_text">Get digital tickets with QR codes for easy and contactless entry.</p>
                            </div>
                        </div>
                        <div class="about-item">
                            <div class="about-item_img">
                                <i class="fas fa-shield-alt" style="font-size: 2rem; color: #086ad8;"></i>
                            </div>
                            <div class="about-item_centent">
                                <h5 class="box-title">Secure Payments</h5>
                                <p class="about-item_text">Safe and secure payment processing with multiple payment options.</p>
                            </div>
                        </div>
                        <div class="about-item">
                            <div class="about-item_img">
