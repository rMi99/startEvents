@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section with Template Style -->
<div class="th-hero-wrapper hero-1" id="hero">
    <div class="swiper th-slider hero-slider-1" id="heroSlide1">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <div class="hero-inner">
                    <div class="th-hero-bg" style="background: linear-gradient(135deg, #684DF4 0%, #8a2be2 100%); min-height: 70vh;"></div>
                    <div class="container">
                        <div class="hero-style1">
                            <span class="sub-title style1" data-ani="slideinup" data-ani-delay="0.2s">Create unforgettable experiences</span>
                            <h1 class="hero-title" data-ani="slideinup" data-ani-delay="0.4s">Discover Amazing Events Near You</h1>
                            <div class="btn-group" data-ani="slideinup" data-ani-delay="0.6s">
                                <a asp-controller="Events" asp-action="Index" class="th-btn th-icon">Explore Events</a>
                                <a href="#about" class="th-btn style2 th-icon">Learn More</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="swiper-slide">
                <div class="hero-inner">
                    <div class="th-hero-bg" style="background: linear-gradient(135deg, #FC3737 0%, #ffbf4f 100%); min-height: 70vh;"></div>
                    <div class="container">
                        <div class="hero-style1">
                            <span class="sub-title style1" data-ani="slideinup" data-ani-delay="0.2s">Book tickets instantly</span>
                            <h1 class="hero-title" data-ani="slideinup" data-ani-delay="0.4s">Your Gateway to Entertainment</h1>
                            <div class="btn-group" data-ani="slideinup" data-ani-delay="0.6s">
                                <a asp-controller="Events" asp-action="Index" class="th-btn th-icon">Book Now</a>
                                <a href="#features" class="th-btn style2 th-icon">Our Features</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="th-swiper-custom">
            <button data-slider-prev="#heroSlide1" class="slider-arrow slider-prev"><i class="fas fa-chevron-left"></i></button>
            <div class="slider-pagination"></div>
            <button data-slider-next="#heroSlide1" class="slider-arrow slider-next"><i class="fas fa-chevron-right"></i></button>
        </div>
    </div>
</div>

<!-- Event Search Section -->
<div class="booking-sec">
    <div class="container">
        <form class="booking-form">
            <div class="input-wrap">
                <div class="row align-items-center justify-content-between">
                    <div class="form-group col-md-6 col-lg-auto">
                        <div class="icon"><i class="fa-light fa-calendar"></i></div>
                        <div class="search-input">
                            <label>Event Type</label>
                            <select class="form-select nice-select">
                                <option value="" selected disabled>Select Event Type</option>
                                <option value="concert">Concerts</option>
                                <option value="theatre">Theatre</option>
                                <option value="cultural">Cultural Events</option>
                                <option value="sports">Sports</option>
                                <option value="conference">Conferences</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group col-md-6 col-lg-auto">
                        <div class="icon"><i class="fa-regular fa-map-marker-alt"></i></div>
                        <div class="search-input">
                            <label>Location</label>
                            <select class="nice-select">
                                <option value="" selected disabled>Select Location</option>
                                <option value="colombo">Colombo</option>
                                <option value="kandy">Kandy</option>
                                <option value="galle">Galle</option>
                                <option value="anuradhapura">Anuradhapura</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group col-md-6 col-lg-auto">
                        <div class="icon"><i class="fa-light fa-clock"></i></div>
                        <div class="search-input">
                            <label>Date</label>
                            <input type="date" class="form-control">
                        </div>
                    </div>
                    <div class="form-group col-md-6 col-lg-auto">
                        <div class="icon"><i class="fa-light fa-tag"></i></div>
                        <div class="search-input">
                            <label>Price Range</label>
                            <select class="form-select nice-select">
                                <option value="" selected disabled>Any Price</option>
                                <option value="free">Free</option>
                                <option value="low">Under $25</option>
                                <option value="medium">$25 - $100</option>
                                <option value="high">$100+</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-btn col-md-12 col-lg-auto">
                        <button class="th-btn"><i class="fas fa-search me-2"></i>Search Events</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

