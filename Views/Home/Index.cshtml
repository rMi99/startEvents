                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Initialize Swiper sliders when document is ready
        document.addEventListener('DOMContentLoaded', function() {
            // Hero slider
            if (document.querySelector('#heroSlide1')) {
                var heroSwiper = new Swiper('#heroSlide1', {
                    effect: 'fade',
                    autoplay: {
                        delay: 5000,
                        disableOnInteraction: false,
                    },
                    pagination: {
                        el: '.slider-pagination',
                        clickable: true,
                    },
                    navigation: {
                        nextEl: '[data-slider-next="#heroSlide1"]',
                        prevEl: '[data-slider-prev="#heroSlide1"]',
                    },
                    loop: true,
                });
            }

            // Category slider
            if (document.querySelector('.categorySlider')) {
                var categorySwiper = new Swiper('.categorySlider', {
                    spaceBetween: 30,
                    autoplay: {
                        delay: 3000,
                        disableOnInteraction: false,
                    },
                    pagination: {
                        el: '.slider-pagination',
                        clickable: true,
                    },
                    breakpoints: {
                        0: {
                            slidesPerView: 1
                        },
                        576: {
                            slidesPerView: 2
                        },
                        768: {
                            slidesPerView: 3
                        },
                        992: {
                            slidesPerView: 4
                        },
                        1200: {
                            slidesPerView: 5
                        }
                    }
                });
            }

            // Tour/Events slider
            if (document.querySelector('.tour-slider .swiper')) {
                var tourSwiper = new Swiper('.tour-slider .swiper', {
                    spaceBetween: 30,
                    autoplay: {
                        delay: 4000,
                        disableOnInteraction: false,
                    },
                    breakpoints: {
                        0: {
                            slidesPerView: 1
                        },
                        576: {
                            slidesPerView: 1
                        },
                        768: {
                            slidesPerView: 2
                        },
                        992: {
                            slidesPerView: 2
                        },
                        1200: {
                            slidesPerView: 3
                        },
                        1300: {
                            slidesPerView: 4
                        }
                    }
                });
            }

            // Add smooth scrolling for anchor links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });

            // Add loading animation to cards
            const cards = document.querySelectorAll('.category-card, .tour-box, .about-item');
            cards.forEach((card, index) => {
                card.style.animationDelay = `${index * 0.1}s`;
                card.classList.add('fade-in-up');
            });

            // Handle search form submission
            const searchForm = document.querySelector('.booking-form');
            if (searchForm) {
                searchForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    // Add your search logic here
                    console.log('Search submitted');
                    // Redirect to events page with search parameters
                    window.location.href = '/Events';
                });
            }
        });
    </script>
}
