@model IEnumerable<online_event_booking.Data.Entities.Event>
@{
    ViewData["Title"] = "Event Management";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="dashboard-content">
    <!-- Page Header -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="page-title">Event Management</h2>
                <p class="page-subtitle">Manage all events in the system</p>
            </div>
            <div>
                <a href="@Url.Action("Create", "Events")" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Add New Event
                </a>
            </div>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-content">
                    <div class="stats-number">@Model.Count()</div>
                    <div class="stats-label">Total Events</div>
                    <div class="stats-change positive">
                        <i class="fas fa-arrow-up"></i> 8%
                    </div>
                </div>
                <div class="stats-icon">
                    <i class="fas fa-calendar"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-content">
                    <div class="stats-number">@Model.Count(e => e.IsPublished)</div>
                    <div class="stats-label">Published</div>
                    <div class="stats-change positive">
                        <i class="fas fa-arrow-up"></i> 12%
                    </div>
                </div>
                <div class="stats-icon">
                    <i class="fas fa-eye"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-content">
                    <div class="stats-number">@Model.Count(e => !e.IsPublished)</div>
                    <div class="stats-label">Draft</div>
                    <div class="stats-change neutral">
                        <i class="fas fa-minus"></i> 0%
                    </div>
                </div>
                <div class="stats-icon">
                    <i class="fas fa-edit"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-content">
                    <div class="stats-number">@Model.Count(e => e.EventDate >= DateTime.Now)</div>
                    <div class="stats-label">Upcoming</div>
                    <div class="stats-change positive">
                        <i class="fas fa-arrow-up"></i> 5%
                    </div>
                </div>
                <div class="stats-icon">
                    <i class="fas fa-clock"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Events Table -->
    <div class="dashboard-card">
        <div class="card-header">
            <h5 class="card-title">All Events</h5>
            <div class="card-actions">
                <button class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-filter"></i> Filter
                </button>
                <button class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-download"></i> Export
                </button>
            </div>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Event Name</th>
                                <th>Venue</th>
                                <th>Date & Time</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Price Range</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var eventItem in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="event-info">
                                            <div class="event-title">@eventItem.Title</div>
                                            <div class="event-description text-muted">
                                                @if (!string.IsNullOrEmpty(eventItem.Description) && eventItem.Description.Length > 50)
                                                {
                                                    @eventItem.Description.Substring(0, 50)...
                                                }
                                                else
                                                {
                                                    @eventItem.Description
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (eventItem.Venue != null)
                                        {
                                            <div>
                                                <div class="fw-medium">@eventItem.Venue.Name</div>
                                                <small class="text-muted">@eventItem.Venue.Location</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No venue assigned</span>
                                        }
                                    </td>
                                    <td>
                                        <div>
                                            <div class="fw-medium">@eventItem.EventDate.ToString("MMM dd, yyyy")</div>
                                            <small class="text-muted">@eventItem.EventTime.ToString("hh:mm tt")</small>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge badge-secondary">@eventItem.Category</span>
                                    </td>
                                    <td>
                                        @if (eventItem.IsPublished)
                                        {
                                            @if (eventItem.EventDate > DateTime.Now.Date)
                                            {
                                                <span class="status-badge status-active">
                                                    <i class="fas fa-circle"></i> Published
                                                </span>
                                            }
                                            else if (eventItem.EventDate == DateTime.Now.Date)
                                            {
                                                <span class="status-badge status-warning">
                                                    <i class="fas fa-circle"></i> Today
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-inactive">
                                                    <i class="fas fa-circle"></i> Completed
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="status-badge status-pending">
                                                <i class="fas fa-circle"></i> Draft
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (eventItem.Prices != null && eventItem.Prices.Any())
                                        {
                                            var minPrice = eventItem.Prices.Min(p => p.Price);
                                            var maxPrice = eventItem.Prices.Max(p => p.Price);
                                            
                                            if (minPrice == maxPrice)
                                            {
                                                <span class="fw-medium">$@minPrice.ToString("F2")</span>
                                            }
                                            else
                                            {
                                                <span class="fw-medium">$@minPrice.ToString("F2") - $@maxPrice.ToString("F2")</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">No pricing</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@eventItem.CreatedAt.ToString("MMM dd, yyyy")</small>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <a href="@Url.Action("Details", "Events", new { id = eventItem.Id })" 
                                               class="btn btn-sm btn-outline-primary" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Edit", "Events", new { id = eventItem.Id })" 
                                               class="btn btn-sm btn-outline-warning" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button class="btn btn-sm btn-outline-danger" 
                                                    onclick="confirmDelete(@eventItem.Id, '@eventItem.Title')" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state text-center py-5">
                    <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No Events Found</h5>
                    <p class="text-muted">There are no events in the system yet.</p>
                    <a href="@Url.Action("Create", "Events")" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Create First Event
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<script>
function confirmDelete(eventId, eventName) {
    if (confirm(`Are you sure you want to delete the event "${eventName}"? This action cannot be undone.`)) {
        // You would typically submit a form or make an AJAX call here
        // For now, we'll redirect to a delete action
        window.location.href = '@Url.Action("Delete", "Events")/' + eventId;
    }
}
</script>
