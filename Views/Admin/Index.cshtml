@model dynamic
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_DashboardLayout";
}

<!-- Dashboard Content -->
<div class="dashboard-content">
    <!-- Top Header -->
    <div class="dashboard-header">
        <div class="header-left">
            <h1 class="page-title">Dashboard Overview</h1>
            <p class="page-subtitle">Welcome back! Here's what's happening with your events.</p>
        </div>
        <div class="header-right">
            <div class="header-actions">
                <button class="btn btn-outline-primary">
                    <i class="fas fa-download"></i> Export
                </button>
                <button class="btn btn-primary">
                    <i class="fas fa-plus"></i> New Event
                </button>
            </div>
        </div>
    </div>

    <!-- Stats Cards Row -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon bg-primary">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <div class="stat-content">
                <h3 class="stat-number">125,467</h3>
                <p class="stat-label">Total Events</p>
                <span class="stat-change positive">
                    <i class="fas fa-arrow-up"></i> +12.5%
                </span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon bg-success">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <h3 class="stat-number">38,920</h3>
                <p class="stat-label">Active Users</p>
                <span class="stat-change positive">
                    <i class="fas fa-arrow-up"></i> +8.2%
                </span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon bg-warning">
                <i class="fas fa-ticket-alt"></i>
            </div>
            <div class="stat-content">
                <h3 class="stat-number">25,450</h3>
                <p class="stat-label">Tickets Sold</p>
                <span class="stat-change positive">
                    <i class="fas fa-arrow-up"></i> +15.3%
                </span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon bg-info">
                <i class="fas fa-dollar-sign"></i>
            </div>
            <div class="stat-content">
                <h3 class="stat-number">$62,875</h3>
                <p class="stat-label">Revenue</p>
                <span class="stat-change positive">
                    <i class="fas fa-arrow-up"></i> +22.1%
                </span>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="charts-row">
        <div class="chart-card">
            <div class="card-header">
                <h5 class="card-title">Revenue Development</h5>
                <div class="card-actions">
                    <button class="btn btn-sm btn-outline-secondary">Weekly</button>
                    <button class="btn btn-sm btn-primary">Monthly</button>
                </div>
            </div>
            <div class="card-body">
                <canvas id="revenueChart" width="400" height="200"></canvas>
            </div>
        </div>

        <div class="activities-card">
            <div class="card-header">
                <h5 class="card-title">Recent Activity</h5>
                <a href="#" class="view-all-link">View All</a>
            </div>
            <div class="card-body">
                <div class="activity-list">
                    <div class="activity-item">
                        <div class="activity-icon bg-primary">
                            <i class="fas fa-calendar-plus"></i>
                        </div>
                        <div class="activity-content">
                            <h6>New Event Created</h6>
                            <p>Summer Music Festival 2025</p>
                            <span class="activity-time">2 hours ago</span>
                        </div>
                    </div>

                    <div class="activity-item">
                        <div class="activity-icon bg-success">
                            <i class="fas fa-ticket-alt"></i>
                        </div>
                        <div class="activity-content">
                            <h6>Ticket Sales Update</h6>
                            <p>150 tickets sold for Tech Conference</p>
                            <span class="activity-time">4 hours ago</span>
                        </div>
                    </div>

                    <div class="activity-item">
                        <div class="activity-icon bg-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <div class="activity-content">
                            <h6>Event Reminder</h6>
                            <p>Art Exhibition starts tomorrow</p>
                            <span class="activity-time">6 hours ago</span>
                        </div>
                    </div>

                    <div class="activity-item">
                        <div class="activity-icon bg-info">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <div class="activity-content">
                            <h6>New User Registration</h6>
                            <p>John Doe joined as organizer</p>
                            <span class="activity-time">8 hours ago</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Row -->
    <div class="bottom-row">
        <div class="events-table-card">
            <div class="card-header">
                <h5 class="card-title">Upcoming Events</h5>
                <div class="card-actions">
                    <button class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-filter"></i> Filter
                    </button>
                    <button class="btn btn-sm btn-primary">
                        <i class="fas fa-plus"></i> Add Event
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Event Name</th>
                                <th>Date</th>
                                <th>Location</th>
                                <th>Tickets Sold</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <div class="event-info">
                                        <div class="event-image">
                                            <img src="/template/assets/images/tour/1.jpg" alt="Event">
                                        </div>
                                        <div>
                                            <h6>Summer Music Festival</h6>
                                            <small class="text-muted">Music • Outdoor</small>
                                        </div>
                                    </div>
                                </td>
                                <td>Jun 15, 2025</td>
                                <td>Central Park</td>
                                <td>
                                    <div class="progress-info">
                                        <span>850/1000</span>
                                        <div class="progress">
                                            <div class="progress-bar bg-primary" style="width: 85%"></div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-success">Active</span></td>
                                <td>
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="event-info">
                                        <div class="event-image">
                                            <img src="/template/assets/images/tour/2.jpg" alt="Event">
                                        </div>
                                        <div>
                                            <h6>Tech Conference 2025</h6>
                                            <small class="text-muted">Technology • Indoor</small>
                                        </div>
                                    </div>
                                </td>
                                <td>Jul 20, 2025</td>
                                <td>Convention Center</td>
                                <td>
                                    <div class="progress-info">
                                        <span>245/500</span>
                                        <div class="progress">
                                            <div class="progress-bar bg-warning" style="width: 49%"></div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-warning">Pending</span></td>
                                <td>
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="event-info">
                                        <div class="event-image">
                                            <img src="/template/assets/images/tour/3.jpg" alt="Event">
                                        </div>
                                        <div>
                                            <h6>Art Exhibition Opening</h6>
                                            <small class="text-muted">Art • Gallery</small>
                                        </div>
                                    </div>
                                </td>
                                <td>Aug 05, 2025</td>
                                <td>Modern Art Gallery</td>
                                <td>
                                    <div class="progress-info">
                                        <span>180/200</span>
                                        <div class="progress">
                                            <div class="progress-bar bg-success" style="width: 90%"></div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-success">Active</span></td>
                                <td>
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="quick-stats-card">
            <div class="card-header">
                <h5 class="card-title">Quick Stats</h5>
            </div>
            <div class="card-body">
                <div class="quick-stat-item">
                    <div class="stat-label">This Month</div>
                    <div class="stat-value">$45,250</div>
                    <div class="stat-change positive">+18.5%</div>
                </div>
                <div class="quick-stat-item">
                    <div class="stat-label">New Customers</div>
                    <div class="stat-value">1,247</div>
                    <div class="stat-change positive">+12.3%</div>
                </div>
                <div class="quick-stat-item">
                    <div class="stat-label">Conversion Rate</div>
                    <div class="stat-value">3.85%</div>
                    <div class="stat-change negative">-2.1%</div>
                </div>
                <div class="quick-stat-item">
                    <div class="stat-label">Avg. Ticket Price</div>
                    <div class="stat-value">$67.50</div>
                    <div class="stat-change positive">+5.7%</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Revenue Chart
        const ctx = document.getElementById('revenueChart').getContext('2d');
        const revenueChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                datasets: [{
                    label: 'Revenue',
                    data: [12000, 19000, 15000, 25000, 22000, 30000, 28000, 35000, 32000, 40000, 38000, 45000],
                    borderColor: '#00b4d8',
                    backgroundColor: 'rgba(0, 180, 216, 0.1)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: 'rgba(0, 0, 0, 0.05)'
                        }
                    },
                    x: {
                        grid: {
                            color: 'rgba(0, 0, 0, 0.05)'
                        }
                    }
                }
            }
        });
    </script>
}
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Header -->
        <div class="content-header">
            <div class="header-left">
                <button class="menu-toggle">
                    <i class="fas fa-bars"></i>
                </button>
                <h1 class="page-title">My Dashboard</h1>
            </div>
            <div class="header-right">
                <div class="header-stats">
                    <span class="stat-badge pending">Pending</span>
                    <span class="stat-period">September 2024</span>
                </div>
                <div class="header-actions">
                    <button class="action-btn">
                        <i class="fas fa-bell"></i>
                    </button>
                    <button class="action-btn">
                        <i class="fas fa-search"></i>
                    </button>
                    <div class="profile-avatar">
                        <img src="https://via.placeholder.com/32" alt="Profile">
                    </div>
                </div>
            </div>
        </div>

        <!-- Profile Section -->
        <div class="profile-section">
            <div class="profile-card">
                <div class="profile-avatar-large">
                    <img src="https://via.placeholder.com/80" alt="Admin Profile">
                </div>
                <div class="profile-info">
                    <h2 class="profile-name">System Administrator</h2>
                    <p class="profile-title">Event Management Admin</p>
                    <div class="profile-actions">
                        <button class="btn-icon">
                            <i class="fas fa-envelope"></i>
                        </button>
                        <button class="btn-icon">
                            <i class="fas fa-phone"></i>
                        </button>
                        <button class="btn-icon">
                            <i class="fas fa-comment"></i>
                        </button>
                        <button class="btn-icon">
                            <i class="fas fa-video"></i>
                        </button>
                    </div>
                </div>
                <div class="profile-meta">
                    <div class="meta-item">
                        <span class="meta-label">Time Slots</span>
                        <div class="time-slot">
                            <span>September, 2024</span>
                            <i class="fas fa-calendar"></i>
                        </div>
                    </div>
                    <div class="meta-item">
                        <span class="meta-label">Meetings</span>
                        <div class="meeting-count">
                            <span class="count">5</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Projects Section -->
            <div class="projects-section">
                <div class="section-header">
                    <div class="dropdown">
                        <button class="dropdown-toggle">
                            Ongoing Projects
                            <i class="fas fa-chevron-down"></i>
                        </button>
                    </div>
                    <div class="section-actions">
                        <button class="btn-icon">
                            <i class="fas fa-search"></i>
                        </button>
                        <button class="btn-icon">
                            <i class="fas fa-filter"></i>
                        </button>
                        <button class="btn-icon">
                            <i class="fas fa-heart"></i>
                        </button>
                    </div>
                </div>

                <div class="projects-grid">
                    <!-- Event Management Project -->
                    <div class="project-card yellow">
                        <div class="project-header">
                            <div class="project-date">September 05, 2024</div>
                            <button class="project-menu">
                                <i class="fas fa-ellipsis-h"></i>
                            </button>
                        </div>
                        <div class="project-content">
                            <h3 class="project-title">Event Management</h3>
                            <div class="project-status">
                                <div class="status-dot"></div>
                                <span class="status-text">Planning</span>
                                <span class="status-progress">80% Progress</span>
                            </div>
                            <div class="project-team">
                                <div class="team-avatars">
                                    <div class="avatar"><img src="https://via.placeholder.com/24" alt="User 1"></div>
                                    <div class="avatar"><img src="https://via.placeholder.com/24" alt="User 2"></div>
                                    <div class="avatar"><img src="https://via.placeholder.com/24" alt="User 3"></div>
                                    <div class="avatar-more">+</div>
                                </div>
                                <div class="days-left">2 Days Left</div>
                            </div>
                        </div>
                    </div>

                    <!-- User Management Project -->
                    <div class="project-card blue">
                        <div class="project-header">
                            <div class="project-date">September 08, 2024</div>
                            <button class="project-menu">
                                <i class="fas fa-ellipsis-h"></i>
                            </button>
                        </div>
                        <div class="project-content">
                            <h3 class="project-title">User Management</h3>
                            <div class="project-status">
                                <div class="status-dot"></div>
                                <span class="status-text">Development</span>
                                <span class="status-progress">90% Progress</span>
                            </div>
                            <div class="project-team">
                                <div class="team-avatars">
                                    <div class="avatar"><img src="https://via.placeholder.com/24" alt="User 1"></div>
                                    <div class="avatar"><img src="https://via.placeholder.com/24" alt="User 2"></div>
                                    <div class="avatar-more">+</div>
                                </div>
                                <div class="days-left">5 Days Left</div>
                            </div>
                        </div>
                    </div>

                    <!-- Analytics Dashboard -->
                    <div class="project-card pink">
                        <div class="project-header">
                            <div class="project-date">September 12, 2024</div>
                            <button class="project-menu">
                                <i class="fas fa-ellipsis-h"></i>
                            </button>
                        </div>
                        <div class="project-content">
                            <h3 class="project-title">Analytics Dashboard</h3>
                            <div class="project-status">
                                <div class="status-dot"></div>
                                <span class="status-text">Testing</span>
                                <span class="status-progress">75% Progress</span>
                            </div>
                            <div class="project-team">
                                <div class="team-avatars">
                                    <div class="avatar"><img src="https://via.placeholder.com/24" alt="User 1"></div>
                                    <div class="avatar"><img src="https://via.placeholder.com/24" alt="User 2"></div>
                                    <div class="avatar"><img src="https://via.placeholder.com/24" alt="User 3"></div>
                                    <div class="avatar-more">+</div>
                                </div>
                                <div class="days-left">8 Days Left</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Section -->
        <div class="bottom-section">
            <!-- Calendar -->
            <div class="calendar-widget">
                <div class="widget-header">
                    <h3>Calendar</h3>
                    <div class="calendar-nav">
                        <button class="nav-btn">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <span class="current-month">September</span>
                        <button class="nav-btn">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
                <div class="calendar-grid">
                    <div class="calendar-header">
                        <div class="day-name">M</div>
                        <div class="day-name">T</div>
                        <div class="day-name">W</div>
                        <div class="day-name">T</div>
                        <div class="day-name">F</div>
                        <div class="day-name">S</div>
                        <div class="day-name">S</div>
                    </div>
                    <div class="calendar-days">
                        @for (int day = 1; day <= 30; day++)
                        {
                            <div class="calendar-day @(day == 2 ? "today" : "") @(day == 5 || day == 12 || day == 18 ? "has-event" : "")">
                                @day
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Inbox -->
            <div class="inbox-widget">
                <div class="widget-header">
                    <h3>Inbox</h3>
                    <div class="inbox-count">5</div>
                </div>
                <div class="inbox-messages">
                    <div class="message-item">
                        <div class="message-avatar">
                            <img src="https://via.placeholder.com/32" alt="User">
                        </div>
                        <div class="message-content">
                            <div class="message-header">
                                <span class="sender-name">Event Planning</span>
                                <div class="message-actions">
                                    <button class="action-btn">
                                        <i class="fas fa-star"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="message-text">New event registration received for Tech Conference 2024</div>
                        </div>
                    </div>

                    <div class="message-item">
                        <div class="message-avatar">
                            <img src="https://via.placeholder.com/32" alt="User">
                        </div>
                        <div class="message-content">
                            <div class="message-header">
                                <span class="sender-name">System Alert</span>
                                <div class="message-actions">
                                    <button class="action-btn">
                                        <i class="fas fa-star"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="message-text">Server maintenance scheduled for this weekend</div>
                        </div>
                    </div>

                    <div class="message-item">
                        <div class="message-avatar">
                            <img src="https://via.placeholder.com/32" alt="User">
                        </div>
                        <div class="message-content">
                            <div class="message-header">
                                <span class="sender-name">User Support</span>
                                <div class="message-actions">
                                    <button class="action-btn">
                                        <i class="fas fa-star"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="message-text">Customer support ticket #1234 requires admin review</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

.modern-dashboard {
    display: flex;
    min-height: 100vh;
    background-color: #f5f6fa;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* Sidebar Styles */
.sidebar {
    width: 280px;
    background: #2c3e50;
    display: flex;
    flex-direction: column;
    position: fixed;
    height: 100vh;
    z-index: 1000;
}

.sidebar-header {
    padding: 2rem 1.5rem;
    border-bottom: 1px solid #34495e;
}

.logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: white;
    font-size: 1.25rem;
    font-weight: 600;
}

.logo i {
    font-size: 1.5rem;
    color: #3498db;
}

.sidebar-nav {
    flex: 1;
    padding: 1rem 0;
}

.nav-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    color: #bdc3c7;
    text-decoration: none;
    transition: all 0.3s ease;
    border-left: 3px solid transparent;
}

.nav-item:hover,
.nav-item.active {
    background-color: #34495e;
    color: white;
    border-left-color: #3498db;
}

.nav-item i {
    width: 20px;
    font-size: 1.1rem;
}

.sidebar-footer {
    padding: 1.5rem;
    border-top: 1px solid #34495e;
}

.user-profile {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.user-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #3498db;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
}

.user-info {
    flex: 1;
}

.user-name {
    color: white;
    font-weight: 500;
    font-size: 0.9rem;
}

.user-role {
    color: #bdc3c7;
    font-size: 0.8rem;
}

/* Main Content */
.main-content {
    flex: 1;
    margin-left: 280px;
    padding: 2rem;
    overflow-y: auto;
}

.content-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
}

.header-left {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.menu-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 1.2rem;
    color: #666;
    cursor: pointer;
}

.page-title {
    font-size: 2rem;
    font-weight: 600;
    color: #2c3e50;
    margin: 0;
}

.header-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
}

.header-stats {
    display: flex;
    align-items: center;
    gap: 1rem;
}

