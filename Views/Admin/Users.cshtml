@model IEnumerable<online_event_booking.Data.Entities.ApplicationUser>
@{
    ViewData["Title"] = "User Management";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-gradient-info text-white">
                <div class="card-body">
                    <h1 class="mb-0"><i class="fas fa-users me-2"></i>User Management</h1>
                    <p class="mb-0">Manage all users and their roles</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Users Table -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">All Users</h5>
                    <div>
                        <button class="btn btn-primary me-2" data-bs-toggle="modal" data-bs-target="#addUserModal">
                            <i class="fas fa-user-plus me-1"></i>Add New User
                        </button>
                        <div class="btn-group">
                            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                Filter by Role
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#" onclick="filterByRole('all')">All Users</a></li>
                                <li><a class="dropdown-item" href="#" onclick="filterByRole('Admin')">Admins</a></li>
                                <li><a class="dropdown-item" href="#" onclick="filterByRole('Organizer')">Organizers</a></li>
                                <li><a class="dropdown-item" href="#" onclick="filterByRole('Customer')">Customers</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="usersTable">
                                <thead class="table-dark">
                                    <tr>
                                        <th>User Info</th>
                                        <th>Email</th>
                                        <th>Phone</th>
                                        <th>Roles</th>
                                        <th>Status</th>
                                        <th>Joined</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model)
                                    {
                                        var roles = userRoles?.ContainsKey(user.Id) == true ? userRoles[user.Id] : new List<string>();
                                        <tr data-user-roles="@string.Join(",", roles)">
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="user-avatar me-3">
                                                        <i class="fas fa-user-circle fa-2x text-muted"></i>
                                                    </div>
                                                    <div>
                                                        <strong>@user.FullName</strong><br>
                                                        <small class="text-muted">@user.UserName</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span>@user.Email</span>
                                                @if (user.EmailConfirmed)
                                                {
                                                    <i class="fas fa-check-circle text-success ms-1" title="Email Confirmed"></i>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-exclamation-circle text-warning ms-1" title="Email Not Confirmed"></i>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                                {
                                                    <span>@user.PhoneNumber</span>
                                                    @if (user.PhoneNumberConfirmed)
                                                    {
                                                        <i class="fas fa-check-circle text-success ms-1" title="Phone Confirmed"></i>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not provided</span>
                                                }
                                            </td>
                                            <td>
                                                @if (roles.Any())
                                                {
                                                    @foreach (var role in roles)
                                                    {
                                                        var badgeClass = role switch
                                                        {
                                                            "Admin" => "bg-danger",
                                                            "Organizer" => "bg-warning",
                                                            "Customer" => "bg-primary",
                                                            _ => "bg-secondary"
                                                        };
                                                        <span class="badge @badgeClass me-1">@role</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-dark">No Role</span>
                                                }
                                            </td>
                                            <td>
                                                @if (user.LockoutEnd.HasValue && user.LockoutEnd > DateTimeOffset.Now)
                                                {
                                                    <span class="badge bg-danger">Locked</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                            </td>
                                            <td>
                                                <small class="text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</small>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <button class="btn btn-sm btn-outline-primary" 
                                                            onclick="viewUser('@user.Id')" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-warning" 
                                                            onclick="editUserRoles('@user.Id', '@user.Email')" title="Edit Roles">
                                                        <i class="fas fa-user-tag"></i>
                                                    </button>
                                                    @if (user.LockoutEnd.HasValue && user.LockoutEnd > DateTimeOffset.Now)
                                                    {
                                                        <button class="btn btn-sm btn-outline-success" 
                                                                onclick="unlockUser('@user.Id')" title="Unlock User">
                                                            <i class="fas fa-unlock"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-sm btn-outline-danger" 
                                                                onclick="lockUser('@user.Id')" title="Lock User">
                                                            <i class="fas fa-lock"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-users fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No Users Found</h5>
                            <p class="text-muted">There are no users in the system yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.bg-gradient-info {
    background: linear-gradient(135deg, #17a2b8 0%, #007bff 100%);
}

.user-avatar {
    min-width: 40px;
}

.table th {
    border-top: none;
    font-weight: 600;
}

.btn-group .btn {
    margin: 0 1px;
}

.badge {
    font-size: 0.75em;
}
</style>

<script>
function filterByRole(role) {
    const rows = document.querySelectorAll('#usersTable tbody tr');
    
    rows.forEach(row => {
        const userRoles = row.getAttribute('data-user-roles');
        if (role === 'all' || userRoles.includes(role)) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
}

function viewUser(userId) {
    // Implement user details view
    alert('View user details for ID: ' + userId);
}

function editUserRoles(userId, userEmail) {
    // Implement role editing functionality
    alert('Edit roles for user: ' + userEmail);
}

function lockUser(userId) {
    if (confirm('Are you sure you want to lock this user?')) {
        // Implement user locking functionality
        alert('Lock user with ID: ' + userId);
    }
}

function unlockUser(userId) {
    if (confirm('Are you sure you want to unlock this user?')) {
        // Implement user unlocking functionality
        alert('Unlock user with ID: ' + userId);
    }
}
</script>
